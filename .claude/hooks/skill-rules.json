{
  "$schema": "./skill-rules.schema.json",
  "version": "2.1",
  "config": {
    "minConfidenceScore": 3,
    "showMatchReasons": true,
    "maxSkillsToShow": 5
  },
  "scoring": {
    "keyword": 2,
    "keywordPattern": 3,
    "pathPattern": 4,
    "directoryMatch": 5,
    "intentPattern": 4,
    "contentPattern": 3,
    "contextPattern": 2
  },
  "directoryMappings": {
    "apps/": "conventions-django",
    "migrations/": "django-models",
    "models/": "django-models",
    "templates/": "django-templates",
    "http/": "conventions-django",
    "docs/": "docs-sync",
    "tests/": "pytest-django-patterns",
    "tasks/": "celery-patterns",
    "forms/": "django-forms"
  },
  "skills": {
    "conventions-django": {
      "description": "Style de développement et structure des projets Django maison (à appliquer en premier)",
      "priority": 10,
      "triggers": {
        "keywords": ["django", "settings", ".env", "requirements", "postgis", "postgresql", "commande de gestion", "management command", "déploiement", "docker", "gunicorn", "nouvelle app", "application django", "structure du projet", "convention"],
        "keywordPatterns": ["\\bmanage\\.py\\b", "\\bmigrations?\\b", "\\bgabarits?\\b", "\\bmodèles?\\b", "\\bvues?\\b", "\\bcommit(?:e[rz]?|s)?\\b", "\\b(?:git )?push\\b", "\\bpousse[rz]?\\b"],
        "pathPatterns": ["**/settings.py", "**/.env.example", "**/requirements*.txt", "**/apps/**", "**/http/*.http", "**/Dockerfile", "**/compose.yaml", "**/docker-compose.yml", "**/management/commands/*.py", "**/urls.py", "**/views.py", "**/admin.py"],
        "intentPatterns": [
          "(?:crée[rz]?|ajoute[rz]?|nouvel(?:le)?).*(?:app|application|modèle|vue|page|commande|migration|variable|intégration|api)",
          "(?:déploie[rz]?|déploiement|dockeris|mise en production)",
          "(?:commit|commite[rz]?|pousse[rz]?|push).*(?:dépôt|github|branche|dev|main)?",
          "(?:create|add|new).*(?:app|model|view|command|migration|setting)"
        ],
        "contentPatterns": ["from django", "models.Model", "manage.py", "INSTALLED_APPS", "load_dotenv"]
      }
    },
    "pytest-django-patterns": {
      "description": "Motifs de test pytest-django et démarche TDD (si le projet a adopté pytest)",
      "priority": 7,
      "triggers": {
        "keywords": ["pytest", "fixture", "factory", "mock", "tdd", "test unitaire"],
        "keywordPatterns": ["\\btest(?:s|ing)?\\b", "\\bspec\\b", "\\bfixture\\b", "\\btester\\b"],
        "pathPatterns": ["**/test_*.py", "**/*_test.py", "**/conftest.py", "**/factories.py"],
        "intentPatterns": [
          "(?:write|add|create|fix).*(?:test)",
          "(?:red.green.refactor|tdd)",
          "(?:écri[rst]|ajoute[rz]?|crée[rz]?|corrige[rz]?).*(?:test)"
        ],
        "contentPatterns": ["@pytest", "def test_", "Factory", "pytest.mark"]
      },
      "excludePatterns": ["e2e", "playwright", "selenium", "rest client", "\\.http\\b"]
    },
    "django-forms": {
      "description": "Gestion des formulaires Django et de leur validation",
      "priority": 7,
      "triggers": {
        "keywords": ["modelform", "validation", "clean", "widget", "formulaire", "champ", "pot de miel"],
        "keywordPatterns": ["\\bform(?:s)?\\b", "Form\\b", "\\bvalidat(?:e|ion)\\b", "\\bformulaires?\\b"],
        "pathPatterns": ["**/forms.py", "**/forms/*.py"],
        "intentPatterns": [
          "(?:create|build|add).*(?:form)",
          "(?:form).*(?:validation|submit|field)",
          "(?:crée[rz]?|ajoute[rz]?|construi[rst]).*(?:formulaire)",
          "(?:formulaire).*(?:validation|soumission|champ)"
        ],
        "contentPatterns": ["forms.Form", "ModelForm", "clean_", "is_valid"]
      },
      "excludePatterns": ["\\bformat", "transform", "platform"]
    },
    "htmx-patterns": {
      "description": "Motifs HTMX pour des gabarits Django dynamiques (si le projet utilise HTMX)",
      "priority": 6,
      "triggers": {
        "keywords": ["htmx", "hx-"],
        "keywordPatterns": ["\\bhtmx\\b", "\\bhx-\\w+\\b"],
        "intentPatterns": [
          "(?:add|create).*(?:htmx)",
          "(?:htmx).*(?:request|swap|trigger)",
          "(?:ajoute[rz]?|crée[rz]?).*(?:htmx)"
        ],
        "contentPatterns": ["hx-get", "hx-post", "hx-target", "hx-swap", "HX-Request"]
      }
    },
    "django-templates": {
      "description": "Héritage de gabarits Django, gabarits partiels, traductions data-i18n",
      "priority": 6,
      "triggers": {
        "keywords": ["template", "html", "extends", "block", "include", "gabarit", "data-i18n", "créole", "traduction"],
        "keywordPatterns": ["\\btemplate\\b", "\\bhtml\\b", "\\bgabarits?\\b", "\\bpartiels?\\b"],
        "pathPatterns": ["**/templates/**/*.html", "**/static/js/traductions/*.js"],
        "intentPatterns": [
          "(?:create|add).*(?:template|page)",
          "(?:crée[rz]?|ajoute[rz]?).*(?:gabarit|template|page)",
          "(?:gabarit|template).*(?:balise|filtre)"
        ],
        "contentPatterns": ["{% extends", "{% block", "{% include", "{% for"]
      }
    },
    "celery-patterns": {
      "description": "Tâches Celery (seulement si une vraie file de tâches est nécessaire ; sinon commande de gestion)",
      "priority": 5,
      "triggers": {
        "keywords": ["celery", "worker", "file d'attente", "tâche de fond", "arrière-plan"],
        "keywordPatterns": ["\\bcelery\\b", "\\.delay\\("],
        "pathPatterns": ["**/tasks.py", "**/tasks/*.py", "**/celery.py"],
        "intentPatterns": [
          "(?:create|add).*(?:celery|background task)",
          "(?:crée[rz]?|ajoute[rz]?).*(?:tâche de fond|arrière-plan|celery)"
        ],
        "contentPatterns": ["@shared_task", "@celery", ".delay(", ".apply_async"]
      }
    },
    "django-models": {
      "description": "Conception des modèles Django, tables héritées (managed=False), migrations, QuerySet",
      "priority": 7,
      "triggers": {
        "keywords": ["model", "queryset", "migration", "orm", "database", "query", "modèle", "base de données", "requête", "managed", "runsql"],
        "keywordPatterns": ["\\bmodel\\b", "\\bqueryset\\b", "\\bmigrations?\\b", "\\bmodèles?\\b"],
        "pathPatterns": ["**/models.py", "**/models/*.py", "**/migrations/*.py"],
        "intentPatterns": [
          "(?:create|add|design).*(?:model)",
          "(?:optimize|fix).*(?:query|n\\+1)",
          "(?:crée[rz]?|ajoute[rz]?|conçoi[st]|concevoir).*(?:modèle|table|champ)",
          "(?:optimise[rz]?|corrige[rz]?).*(?:requête|n\\+1)"
        ],
        "contentPatterns": ["models.Model", "models.CharField", "objects.filter", "select_related", "RunSQL"]
      }
    },
    "systematic-debugging": {
      "description": "Débogage en quatre phases avec analyse de la cause racine",
      "priority": 9,
      "triggers": {
        "keywords": ["bug", "debug", "error", "broken", "failing", "erreur", "bogue", "plante", "échoue", "problème", "traceback"],
        "keywordPatterns": ["\\bbug\\b", "\\berror\\b", "doesn't work", "not working", "\\berreurs?\\b", "ne (?:marche|fonctionne|s'affiche) (?:pas|plus)", "\\b(?:500|404|403)\\b"],
        "intentPatterns": [
          "(?:fix|debug|resolve|investigate).*(?:bug|error|issue|problem)",
          "(?:why).*(?:not working|broken|failing)",
          "(?:corrige[rz]?|débogue[rz]?|résou(?:s|dre)|enquête[rz]?|analyse[rz]?).*(?:bug|bogue|erreur|problème)",
          "(?:pourquoi).*(?:marche pas|fonctionne pas|échoue|plante|s'affiche pas)"
        ]
      },
      "excludePatterns": ["fix typo", "fix formatting", "fix lint", "corrige la faute", "corrige le formatage", "corrige le lint"]
    },
    "code-quality": {
      "description": "Contrôles de qualité (check Django, migrations, syntaxe, requêtes .http) et constats par gravité",
      "priority": 6,
      "triggers": {
        "keywords": ["qualité du code", "code quality", "lint", "contrôle qualité", "contrôles de qualité", "audit du code"],
        "intentPatterns": [
          "(?:vérifie[rz]?|contrôle[rz]?|audite[rz]?).*(?:qualité|code)",
          "(?:check|run).*(?:quality|lint)"
        ]
      }
    },
    "worktree-commit-merge": {
      "description": "Commiter les changements du worktree et fusionner dans la branche cible (sans attribution Claude)",
      "priority": 8,
      "triggers": {
        "keywords": ["worktree", "fusionne", "fusion"],
        "keywordPatterns": ["\\bworktree\\b", "\\bmerge.*(?:master|main|dev)\\b", "\\bfusionne.*(?:master|main|dev)\\b"],
        "intentPatterns": [
          "commit.*(?:and|then).*merge",
          "merge.*(?:to|into).*(?:master|main)",
          "(?:done|finished).*worktree",
          "commit.*(?:et|puis).*(?:fusionne|merge)",
          "(?:fusionne|merge).*(?:dans|sur|vers).*(?:master|main|dev)",
          "(?:fini|terminé).*worktree"
        ]
      }
    },
    "docs-sync": {
      "description": "Documentation, docstrings et cohérence entre docs et code",
      "priority": 4,
      "triggers": {
        "keywords": ["documentation", "docstring", "readme", "docs", "documenter"],
        "keywordPatterns": ["\\bdoc(?:s|umentation)?\\b", "\\breadme\\b"],
        "pathPatterns": ["**/docs/**", "**/*.md", "**/README*"],
        "intentPatterns": [
          "(?:write|add|update).*(?:doc|documentation)",
          "(?:écri[rst]|ajoute[rz]?|mets? à jour).*(?:doc|documentation)",
          "(?:documente[rz]?).*(?:fonction|classe|api)"
        ]
      }
    }
  }
}
