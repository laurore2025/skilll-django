# Active le venv Python (dossier venv/ à la racine) du dépôt principal (fonctionne aussi dans les worktrees)
_main_venv="$(git worktree list --porcelain | awk 'NR==1{print $2}')/venv"
export VIRTUAL_ENV="$_main_venv"
PATH_add "$_main_venv/bin"

# Charge les secrets et la configuration partagés depuis le worktree principal, avec surcharge locale possible.
# Ainsi, les worktrees récupèrent .env et .envrc.local sans copie manuelle.
_main_worktree="$(git worktree list --porcelain | awk 'NR==1{print $2}')"
dotenv_if_exists "$_main_worktree/.env"
dotenv_if_exists ".env"
